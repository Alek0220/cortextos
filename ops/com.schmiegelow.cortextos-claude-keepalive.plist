<?xml version="1.0" encoding="UTF-8"?>
<!--
  cortextOS — Claude Code OAuth keep-alive (single-writer strategy).

  Purpose:
    cortextOS council members read the Claude Code Max OAuth token from the
    macOS keychain to call the Anthropic Messages API. cortextOS NEVER
    refreshes the token itself — that would cause a refresh-token rotation
    race with the Claude Code CLI, logging the user out of one or the other.

    This launchd job runs `claude --version` every ~6 hours so the Claude
    Code CLI itself notices the upcoming expiry (8h life, 30s pre-expiry
    buffer) and refreshes the keychain. cortextOS just reads the result.

  Install:
    cp ops/com.schmiegelow.cortextos-claude-keepalive.plist \
       ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.schmiegelow.cortextos-claude-keepalive.plist

  Verify:
    launchctl list | grep cortextos-claude-keepalive
    tail -f /tmp/cortextos-claude-keepalive.log

  Uninstall:
    launchctl unload -w ~/Library/LaunchAgents/com.schmiegelow.cortextos-claude-keepalive.plist
    rm ~/Library/LaunchAgents/com.schmiegelow.cortextos-claude-keepalive.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.schmiegelow.cortextos-claude-keepalive</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/schmiegelowfms/.local/bin/claude</string>
        <string>--version</string>
    </array>

    <!-- Every 6 hours (token life is 8h, leaves 2h buffer). -->
    <key>StartInterval</key>
    <integer>21600</integer>

    <!-- Run once at load so the keychain is fresh immediately. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/cortextos-claude-keepalive.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cortextos-claude-keepalive.log</string>

    <!-- Inherit user PATH so `claude` can find its node runtime. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/schmiegelowfms/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/schmiegelowfms</string>
    </dict>
</dict>
</plist>
